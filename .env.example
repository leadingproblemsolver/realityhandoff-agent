# Canonical hackathon path: self-hosted DataHub Core + official Python MCP server.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# Expose MCP mutation tools server-side so capability discovery can see update_description.
# Agent-side ALLOW_DATAHUB_MUTATIONS remains a separate authorization boundary.
DATAHUB_SERVER_MUTATIONS_ENABLED=true
SAVE_DOCUMENT_TOOL_ENABLED=true

# Optional remote DataHub Cloud MCP path. Leave blank for self-hosted mode.
DATAHUB_MCP_URL=
DATAHUB_TOKEN=

# BYOK model. Optional for deterministic replay; recommended for live semantic compilation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Safety controls.
ALLOW_DATAHUB_MUTATIONS=false
REQUIRE_HUMAN_APPROVAL=true
DEMO_TARGET_URN=
MAX_CONTEXT_ENTITIES=3
MAX_CONTEXT_ROUNDS=2

# LangSmith / LangGraph deployment (optional locally).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=reality-handoff-agent
