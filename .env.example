# DataHub Cloud direct tenant MCP endpoint.
DATAHUB_MCP_URL=https://<tenant>.acryl.io/integrations/ai/mcp/
DATAHUB_TOKEN=

# BYOK model. The model interprets evidence and proposes bounded metadata text;
# deterministic Python owns blocking decisions and verification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Safety controls.
ALLOW_DATAHUB_MUTATIONS=false
REQUIRE_HUMAN_APPROVAL=true
# Strongly recommended for a public demo: restrict writes to exactly one showcase asset.
DEMO_TARGET_URN=
MAX_CONTEXT_ENTITIES=3
MAX_CONTEXT_ROUNDS=2

# LangSmith / LangGraph deployment (optional locally, expected for hosted deployment).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=reality-handoff-agent
